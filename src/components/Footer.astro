---
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const t = useTranslations(Astro.props.locale);
const year = new Date().getFullYear();
---

<footer class="container footer">
  <span>
    © {year} Maxim Tokinlo · {t('footer.credit')}
  </span>
  <span class="social">
    <a
      class="link"
      href="https://www.linkedin.com/in/maxim-tokinlo-098915247"
      rel="me noopener"
      target="_blank"
    >
      LinkedIn
    </a>
    <a class="link" href="https://github.com/maximghost" rel="me noopener" target="_blank">
      GitHub
    </a>
  </span>
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    padding-top: 32px;
    padding-bottom: 48px;
    font-size: 13px;
    color: var(--muted);
  }

  .social {
    display: flex;
    gap: 24px;
  }

  .social a {
    color: var(--ink-2);
  }
</style>
