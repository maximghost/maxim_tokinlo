---
import { locales, localeNames, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { localePath, switchLocalePath } from '../i18n/utils';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const home = `/${locale}/`;
---

<a class="skip-link" href="#contenu">
  {t('a11y.skip')}
</a>

<header class="bar" data-header>
  <div class="container header">
    <a href={home} class="brand fade" aria-label="Maxim Tokinlo">
      <Logo />
      <span>Maxim Tokinlo</span>
    </a>

    <button
      class="menu-btn"
      type="button"
      aria-expanded="false"
      aria-controls="site-menu"
      data-menu-toggle
      data-label-open={t('nav.menu')}
      data-label-close={t('nav.close')}
      aria-label={t('nav.menu')}
    >
      <span class="menu-icon" aria-hidden="true">
        <span></span>
        <span></span>
      </span>
    </button>

    <div class="actions fade" id="site-menu" style="animation-delay: 0.15s">
      <nav class="nav" aria-label={t('nav.label')}>
        <a href={`${home}#projets`} style="--i: 0">
          {t('nav.projects')}
        </a>
        <a href={localePath(locale, 'about')} style="--i: 1">
          {t('nav.journey')}
        </a>
        <a href={`${home}#contact`} style="--i: 2">
          {t('nav.contact')}
        </a>
      </nav>

      <div class="tools">
        <ul class="langs" aria-label={t('lang.label')}>
          {locales.map((l) => (
            <li>
              <a
                href={switchLocalePath(Astro.url, l)}
                hreflang={l}
                lang={l}
                data-locale-link={l}
                aria-current={l === locale ? 'true' : undefined}
                title={localeNames[l]}
              >
                <span aria-hidden="true">{l.toUpperCase()}</span>
                <span class="sr-only">{localeNames[l]}</span>
              </a>
            </li>
          ))}
        </ul>
        <ThemeToggle toDark={t('theme.toDark')} toLight={t('theme.toLight')} />
      </div>
    </div>
  </div>
</header>

<script>
  /*
   * Sticky header: it slips away while reading down and comes back as soon
   * as the visitor scrolls up, so the language and theme switches are
   * always one gesture away.
   */
  const bar = document.querySelector<HTMLElement>('[data-header]');
  let lastY = window.scrollY;
  let ticking = false;

  const update = () => {
    const y = window.scrollY;
    if (bar) {
      bar.classList.toggle('is-scrolled', y > 24);
      const goingDown = y > lastY + 4;
      const goingUp = y < lastY - 4;
      if (goingDown && y > 160 && !bar.contains(document.activeElement)) bar.classList.add('is-hidden');
      if (goingUp || y <= 160) bar.classList.remove('is-hidden');
    }
    lastY = y;
    ticking = false;
  };

  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        requestAnimationFrame(update);
        ticking = true;
      }
    },
    { passive: true },
  );
  bar?.addEventListener('focusin', () => bar.classList.remove('is-hidden'));
  update();

  /*
   * Mobile menu: on small screens, navigation, languages and theme live in
   * a full-screen panel opened by the menu button.
   */
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const mobile = matchMedia('(max-width: 820px)');

  const setMenu = (open: boolean) => {
    if (!toggle || !bar) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? '');
    bar.classList.toggle('menu-open', open);
    if (open) bar.classList.remove('is-hidden');
  };

  toggle?.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));

  document
    .querySelectorAll<HTMLAnchorElement>('#site-menu .nav a')
    .forEach((link) => link.addEventListener('click', () => setMenu(false)));

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      toggle.focus();
    }
  });

  mobile.addEventListener('change', (event) => {
    if (!event.matches) setMenu(false);
  });

  /*
   * Language switch without losing your place: the link is sent to the
   * same page in the other language, anchored on the section currently
   * on screen. The choice is remembered for the next visit.
   */
  document.querySelectorAll<HTMLAnchorElement>('[data-locale-link]').forEach((link) => {
    link.addEventListener('click', () => {
      try {
        localStorage.setItem('locale', link.dataset.localeLink ?? '');
      } catch {}

      const sections = [...document.querySelectorAll<HTMLElement>('main section[id]')];
      const current = sections.filter((s) => s.getBoundingClientRect().top <= window.innerHeight * 0.4).pop();
      if (current && window.scrollY > 200) {
        const url = new URL(link.href);
        url.hash = current.id;
        link.href = url.toString();
      }
    });
  });
</script>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition:
      transform 0.6s var(--ease-out),
      background-color 0.5s ease,
      border-color 0.5s ease,
      backdrop-filter 0.5s ease;
  }

  .bar:global(.is-scrolled) {
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    border-bottom-color: var(--line-soft);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    backdrop-filter: saturate(1.4) blur(14px);
  }

  .bar:global(.is-hidden) {
    transform: translateY(-100%);
  }

  /* Fixed children need an ancestor without filters or transforms. */
  .bar:global(.menu-open) {
    transition: none;
    transform: none;
    background: var(--bg);
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    border-bottom-color: transparent;
  }

  .bar:global(.is-scrolled) .header {
    padding-top: 14px;
    padding-bottom: 14px;
  }

  .header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
    padding-top: 28px;
    padding-bottom: 28px;
    transition: padding 0.6s var(--ease-out);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    color: var(--ink);
    text-decoration: none;
    font-size: 16px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 32px;
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
    font-size: 14px;
  }

  .nav a,
  .langs a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.4s ease;
  }

  .nav a:hover,
  .langs a:hover,
  .langs a[aria-current='true'] {
    color: var(--ink);
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-left: 24px;
    border-left: 1px solid var(--line);
  }

  .langs {
    display: flex;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 13px;
    letter-spacing: 0.04em;
  }

  .langs a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
  }

  .langs a[aria-current='true'] {
    font-weight: 500;
  }

  .menu-btn {
    display: none;
  }

  /* ---------- Small screens: one compact row + full-screen menu ---------- */
  @media (max-width: 820px) {
    .header {
      flex-wrap: nowrap;
      padding-top: 16px;
      padding-bottom: 16px;
    }

    .bar:global(.is-scrolled) .header {
      padding-top: 10px;
      padding-bottom: 10px;
    }

    .brand {
      position: relative;
      z-index: 2;
    }

    .menu-btn {
      position: relative;
      z-index: 2;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      padding: 0;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: transparent;
      color: var(--ink);
      cursor: pointer;
    }

    .menu-icon {
      position: relative;
      width: 16px;
      height: 8px;
    }

    .menu-icon span {
      position: absolute;
      left: 0;
      width: 100%;
      height: 1.5px;
      border-radius: 2px;
      background: currentColor;
      transition:
        transform 0.6s var(--ease-out),
        top 0.6s var(--ease-out);
    }

    .menu-icon span:first-child {
      top: 0;
    }

    .menu-icon span:last-child {
      top: 6.5px;
    }

    [aria-expanded='true'] .menu-icon span:first-child {
      top: 3.25px;
      transform: rotate(45deg);
    }

    [aria-expanded='true'] .menu-icon span:last-child {
      top: 3.25px;
      transform: rotate(-45deg);
    }

    .actions {
      position: fixed;
      inset: 0;
      z-index: 1;
      flex-direction: column;
      flex-wrap: nowrap;
      align-items: stretch;
      justify-content: space-between;
      gap: 32px;
      height: 100dvh;
      padding: 104px var(--gutter) max(32px, env(safe-area-inset-bottom));
      overflow-y: auto;
      /* The page behind never scrolls while the menu is open. */
      overscroll-behavior: contain;
      background: var(--bg);
      visibility: hidden;
      clip-path: inset(0 0 100% 0);
      transition:
        clip-path 0.7s var(--ease-in-out),
        visibility 0s linear 0.7s;
    }

    .bar:global(.menu-open) .actions {
      visibility: visible;
      clip-path: inset(0);
      transition:
        clip-path 0.7s var(--ease-in-out),
        visibility 0s;
    }

    .nav {
      flex-direction: column;
      flex-wrap: nowrap;
      gap: 4px;
    }

    .nav a {
      font-size: clamp(36px, 11vw, 52px);
      font-weight: 500;
      letter-spacing: -0.04em;
      line-height: 1.15;
      color: var(--ink);
      opacity: 0;
      transform: translateY(24px);
      transition:
        opacity 0.6s var(--ease-out),
        transform 0.8s var(--ease-out);
    }

    .bar:global(.menu-open) .nav a {
      opacity: 1;
      transform: none;
      transition-delay: calc(0.25s + var(--i) * 0.07s);
    }

    .tools {
      justify-content: space-between;
      padding: 24px 0 0;
      border-left: 0;
      border-top: 1px solid var(--line);
    }

    .langs {
      font-size: 15px;
    }

    .langs a {
      min-width: 48px;
    }
  }
</style>
