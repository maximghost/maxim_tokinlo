---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { localePath, projectSlug } from '../i18n/utils';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
  locale: Locale;
}

const { project, index, locale } = Astro.props;
const t = useTranslations(locale);
const href = localePath(locale, 'projects', projectSlug(project));
const { title, category, tagline, summary, stats, stack, links, images, status } = project.data;
const number = String(index).padStart(2, '0');
// The first line of the tagline is set in italic serif.
const [taglineAccent, ...taglineRest] = tagline.split(',');
const chips = stack.filter((s) => !['Vite', 'Tailwind CSS v4', 'Framer Motion', 'PostgreSQL'].includes(s));
---

<article class="card reveal">
  <div class="body">
    <p class="meta">
      <span class="tabular">{number}</span>
      <span class="dash" aria-hidden="true"></span>
      {category && <span>{category}</span>}
    </p>
    <h3 class="title">{title}</h3>
    <p class="tagline">
      {taglineRest.length > 0 ? (
        <>
          <span class="serif">{taglineAccent},</span>
          {taglineRest.join(',')}
        </>
      ) : (
        tagline
      )}
    </p>
    <p class="summary">{summary}</p>

    {stats.length > 0 && (
      <dl class="stats">
        {stats.map((s) => (
          <div>
            <dt class="tabular" data-count={/^\d+$/.test(s.value) ? s.value : undefined}>
              {s.value}
            </dt>
            <dd>{s.label}</dd>
          </div>
        ))}
      </dl>
    )}

    {chips.length > 0 && (
      <ul class="chips">
        {chips.map((c) => (
          <li>{c}</li>
        ))}
      </ul>
    )}

    <div class="links">
      <a href={href} class="link">
        {t('projects.caseStudy')}{' '}
        <span class="arrow" aria-hidden="true">
          →
        </span>
      </a>
      {links.demo && (
        <a href={links.demo} class="link accent" target="_blank" rel="noopener">
          {t('projects.demo')} <span aria-hidden="true">↗</span>
        </a>
      )}
      {links.site && (
        <a href={links.site} class="link" target="_blank" rel="noopener">
          {t('projects.site')} <span aria-hidden="true">↗</span>
        </a>
      )}
    </div>
  </div>

  {images.length > 0 && (
    <div class="stage">
      {images.slice(0, 2).map((img, i) => (
        <div class:list={['phone', i === 0 ? 'phone-a' : 'phone-b']}>
          <Image
            src={img.src}
            alt={img.alt}
            widths={[280, 460, 628]}
            sizes="(max-width: 900px) 40vw, 230px"
          />
        </div>
      ))}
      <p class="status">{status}</p>
    </div>
  )}
</article>

<style>
  .card {
    display: flex;
    flex-wrap: wrap;
    margin-top: 64px;
    overflow: hidden;
    border-radius: 28px;
    background: var(--surface);
    transition: background-color 0.5s ease;
  }

  .body {
    display: flex;
    flex: 1 1 440px;
    flex-direction: column;
    min-width: 0;
    padding: clamp(28px, 4vw, 56px);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin: 0;
    font-size: 13px;
    color: var(--muted);
  }

  .dash {
    width: 24px;
    height: 1px;
    background: var(--decor);
  }

  .title {
    margin: 28px 0 0;
    font-weight: 500;
    font-size: clamp(40px, 5vw, 64px);
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .tagline {
    margin: 12px 0 0;
    font-size: 22px;
    line-height: 1.35;
    color: var(--ink-2);
  }

  .summary {
    max-width: 480px;
    margin: 24px 0 0;
    font-size: 16px;
    line-height: 1.65;
    color: var(--ink-2);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 36px 0 0;
    padding: 24px 0;
    border-top: 1px solid var(--line-soft);
    border-bottom: 1px solid var(--line-soft);
  }

  .stats dt {
    font-size: 34px;
    font-weight: 500;
    letter-spacing: -0.04em;
  }

  .stats dd {
    margin: 4px 0 0;
    font-size: 13px;
    color: var(--muted);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .chips li {
    padding: 6px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 13px;
    color: var(--ink-2);
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    margin-top: auto;
    padding-top: 40px;
    font-size: 15px;
    font-weight: 500;
  }

  .stage {
    position: relative;
    display: flex;
    flex: 1 1 420px;
    align-items: center;
    justify-content: center;
    min-width: 0;
    min-height: 520px;
    padding: 48px 24px 64px;
    background: var(--stage);
    transition: background-color 0.5s ease;
  }

  .phone {
    width: 42%;
    max-width: 230px;
  }

  .phone :global(img) {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 30px 40px var(--shadow-phone));
    transition: transform 1.1s var(--ease-out);
  }

  .phone-a {
    position: relative;
    z-index: 1;
    margin-right: -6%;
    animation: float 7s ease-in-out infinite;
  }

  .phone-b {
    margin-top: 72px;
    animation: float 7s ease-in-out -3.5s infinite;
  }

  .card:hover .phone-a :global(img) {
    transform: translateX(-14px) rotate(-2deg);
  }

  .card:hover .phone-b :global(img) {
    transform: translateX(14px) rotate(2deg);
  }

  .status {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 20px;
    margin: 0;
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--stage-ink);
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }
</style>
