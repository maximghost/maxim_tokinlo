---
import ProjectView from '../../../views/ProjectView.astro';
import NewsArticleView from '../../../views/NewsArticleView.astro';
import { locales, routes } from '../../../i18n/config';
import { getNews, getProjects, newsSlug, projectSlug } from '../../../i18n/utils';

/*
 * Detail pages, one per item and per language:
 * a case study per public project (/fr/projets/gamberge/), confidential projects get none;
 * an article per news item (/fr/actualites/sfm/).
 */
export async function getStaticPaths() {
  const paths = [];
  for (const locale of locales) {
    const projects = (await getProjects(locale)).filter((p) => !p.data.confidential);
    for (const [i, project] of projects.entries()) {
      const next = projects[(i + 1) % projects.length];
      paths.push({
        params: { lang: locale, section: routes.projects[locale], slug: projectSlug(project) },
        props: {
          kind: 'project' as const,
          locale,
          project,
          next: next && next !== project ? next : undefined,
        },
      });
    }
    const news = await getNews(locale);
    for (const item of news) {
      paths.push({
        params: { lang: locale, section: routes.news[locale], slug: newsSlug(item) },
        props: { kind: 'news' as const, locale, item, others: news.filter((n) => n !== item).slice(0, 2) },
      });
    }
  }
  return paths;
}

const props = Astro.props;
---

{props.kind === 'project' ? (
  <ProjectView locale={props.locale} project={props.project} next={props.next} />
) : (
  <NewsArticleView locale={props.locale} item={props.item} others={props.others} />
)}
