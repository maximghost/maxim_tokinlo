---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Constellation from '../../components/Constellation.astro';
import FeaturedProject from '../../components/FeaturedProject.astro';
import ProjectRow from '../../components/ProjectRow.astro';
import { locales, type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { getProjects } from '../../i18n/utils';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);
const projects = await getProjects(locale);
const [featured, ...others] = projects;
const approach = [1, 2, 3] as const;
---

<Base locale={locale} title={t('meta.title')} description={t('meta.description')}>
  <Header locale={locale} />

  <main id="contenu">
    <!-- Hero -->
    <section id="haut" class="container hero">
      <Constellation />

      <p class="kicker fade" style="animation-delay: 0.2s">
        <span>{t('hero.kicker')}</span>
        <span class="kicker-rule rule" style="animation-delay: 0.5s" aria-hidden="true"></span>
        <span>{t('hero.place')}</span>
      </p>

      <h1 class="hero-title">
        <span class="line"><span style="animation-delay: 0.3s">{t('hero.line1')}</span></span>
        <span class="line">
          <span style="animation-delay: 0.42s">
            {t('hero.line2.before')}<span class="serif accent">{t('hero.line2.accent')}</span>{t('hero.line2.after')}
          </span>
        </span>
        <span class="line"><span class="dim" style="animation-delay: 0.54s">{t('hero.line3')}</span></span>
      </h1>

      <div class="hero-bottom fade" style="animation-delay: 0.9s">
        <p class="hero-text">{t('hero.text')}</p>
        <div class="hero-ctas">
          <a href="#projets" class="btn btn-primary">
            {t('hero.cta.primary')} <span class="arrow" aria-hidden="true">→</span>
          </a>
          <a href="#contact" class="btn btn-ghost">{t('hero.cta.secondary')}</a>
        </div>
      </div>

      <ul class="hero-meta fade" style="animation-delay: 1.1s">
        <li><strong>{t('hero.meta1.strong')}</strong>{t('hero.meta1.rest')}</li>
        <li><strong>{t('hero.meta2.strong')}</strong>{t('hero.meta2.rest')}</li>
        <li>{t('hero.meta3.before')}<strong>{t('hero.meta3.strong')}</strong></li>
      </ul>
    </section>

    <!-- Approach -->
    <section id="approche" class="container section">
      <p class="eyebrow reveal"><span class="tabular">01</span><span>{t('approach.label')}</span></p>
      <h2 class="section-title reveal" style="max-width: 760px">
        {t('approach.title.before')}<span class="serif">{t('approach.title.accent')}</span>
      </h2>
      <div class="pillars">
        {approach.map((n) => (
          <article class="pillar reveal">
            <p class="pillar-num tabular">— 0{n}</p>
            <h3>{t(`approach.${n}.title`)}</h3>
            <p>{t(`approach.${n}.text`)}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- Projects -->
    <section id="projets" class="container section">
      <div class="projects-head">
        <div>
          <p class="eyebrow reveal"><span class="tabular">02</span><span>{t('projects.label')}</span></p>
          <h2 class="section-title reveal">
            {t('projects.title.before')}<span class="serif">{t('projects.title.accent')}</span>
          </h2>
        </div>
        <p class="projects-intro reveal">{t('projects.intro')}</p>
      </div>

      {featured && <FeaturedProject project={featured} index={1} locale={locale} />}

      <div class="rows">
        {others.map((project, i) => (
          <ProjectRow project={project} index={i + 2} locale={locale} />
        ))}
      </div>
    </section>

    <!-- Journey -->
    <section id="parcours" class="container section section-lg">
      <p class="eyebrow reveal"><span class="tabular">03</span><span>{t('journey.label')}</span></p>
      <p class="quote reveal">
        {t('journey.quote.before')}<span class="accent">{t('journey.quote.accent')}</span>
      </p>
      <div class="journey-bottom">
        <p class="journey-text reveal">{t('journey.text')}</p>
        <a href="#parcours" class="link reveal journey-link">
          {t('journey.link')} <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <!-- Ghost.Technologies -->
    <section id="ghost" class="band">
      <div class="container band-inner">
        <div class="band-title-wrap">
          <p class="eyebrow band-eyebrow reveal">{t('ghost.label')}</p>
          <h2 class="band-title reveal">Ghost<span class="accent">.</span>Technologies</h2>
        </div>
        <p class="band-text reveal">{t('ghost.text')}</p>
      </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="container section contact">
      <p class="eyebrow reveal">{t('contact.label')}</p>
      <h2 class="contact-title reveal">
        {t('contact.title.before')}<span class="serif">{t('contact.title.accent')}</span>
      </h2>
      <div class="contact-bottom reveal">
        <p>{t('contact.text')}</p>
        <a href="mailto:yaovitokinlo13@gmail.com" class="btn btn-primary btn-lg">
          {t('contact.cta')} <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </main>

  <Footer locale={locale} />
</Base>

<style>
  .section {
    padding-top: 96px;
    padding-bottom: 96px;
  }

  .section-lg {
    padding-top: 120px;
    padding-bottom: 120px;
  }

  /* Hero */
  .hero {
    position: relative;
    padding-top: clamp(56px, 9vw, 120px);
    padding-bottom: 72px;
  }

  .kicker {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 0;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .kicker-rule {
    display: block;
    width: 48px;
    height: 1px;
    background: var(--faint);
  }

  .hero-title {
    position: relative;
    max-width: 1080px;
    margin: 32px 0 0;
    font-weight: 500;
    font-size: clamp(44px, 7.4vw, 104px);
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .dim {
    color: var(--faint);
  }

  .hero-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    margin-top: 48px;
  }

  .hero-text {
    max-width: 520px;
    margin: 0;
    font-size: 18px;
    line-height: 1.6;
    color: var(--ink-2);
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px 32px;
    margin: 88px 0 0;
    padding: 24px 0 0;
    border-top: 1px solid var(--line);
    list-style: none;
    font-size: 14px;
    color: var(--muted);
  }

  .hero-meta strong {
    font-weight: 400;
    color: var(--ink);
  }

  /* Approach */
  .pillars {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    margin-top: 64px;
  }

  .pillar {
    padding: 32px 32px 32px 0;
    border-top: 1px solid var(--line-strong);
  }

  .pillar-num {
    margin: 0;
    font-size: 13px;
    color: var(--faint);
  }

  .pillar h3 {
    margin: 40px 0 0;
    font-weight: 500;
    font-size: 26px;
    letter-spacing: -0.025em;
  }

  .pillar p:last-child {
    margin: 14px 0 0;
    font-size: 16px;
    line-height: 1.65;
    color: var(--ink-2);
  }

  /* Projects */
  .projects-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }

  .projects-intro {
    max-width: 400px;
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
  }

  .rows {
    margin-top: 24px;
    border-top: 1px solid var(--line-strong);
  }

  /* Journey */
  .quote {
    max-width: 1040px;
    margin: 40px 0 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(34px, 4.6vw, 64px);
    line-height: 1.08;
    letter-spacing: -0.015em;
  }

  .journey-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 32px 64px;
    margin-top: 56px;
  }

  .journey-text {
    flex: 1 1 420px;
    max-width: 560px;
    margin: 0;
    font-size: 17px;
    line-height: 1.7;
    color: var(--ink-2);
  }

  .journey-link {
    font-size: 15px;
    font-weight: 500;
  }

  /* Ghost band */
  .band {
    background: var(--band-bg);
    color: var(--band-ink);
    transition: background-color 0.5s ease;
  }

  :global([data-theme='dark']) .band {
    border-block: 1px solid var(--line);
  }

  .band-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px 80px;
    padding-top: 112px;
    padding-bottom: 112px;
  }

  .band-title-wrap {
    flex: 1 1 480px;
    min-width: 0;
  }

  .band-eyebrow {
    color: var(--band-muted);
  }

  .band-title {
    margin: 24px 0 0;
    font-weight: 500;
    font-size: clamp(36px, 5vw, 68px);
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .band-text {
    flex: 1 1 380px;
    max-width: 480px;
    margin: 0;
    font-size: 17px;
    line-height: 1.7;
    color: var(--band-muted);
  }

  /* Contact */
  .contact {
    padding-top: 136px;
  }

  .contact-title {
    margin: 28px 0 0;
    font-weight: 500;
    font-size: clamp(44px, 7vw, 100px);
    line-height: 0.98;
    letter-spacing: -0.05em;
  }

  .contact-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 56px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }

  .contact-bottom p {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-2);
  }

  .btn-lg {
    min-height: 56px;
    padding: 0 30px;
    font-size: 16px;
  }
</style>
