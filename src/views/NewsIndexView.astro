---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactDialog from '../components/ContactDialog.astro';
import NewsCard from '../components/NewsCard.astro';
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { getNews } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const items = await getNews(locale);
const email = 'yaovitokinlo13@gmail.com';
---

<Base locale={locale} title={t('news.page.title')} description={t('news.page.description')}>
  <Header locale={locale} />

  <main id="contenu">
    <header class="container intro">
      <p class="eyebrow fade" style="animation-delay: 0.1s">
        {t('news.label')}
      </p>
      <h1 class="title">
        <span class="line">
          <span style="animation-delay: 0.2s">{t('news.title.before')}</span>
        </span>
        <span class="line">
          <span class="serif accent" style="animation-delay: 0.35s">
            {t('news.title.accent')}
          </span>
        </span>
      </h1>
      <p class="lead fade" style="animation-delay: 0.55s">
        {t('news.page.lead')}
      </p>
    </header>

    <section class="container">
      <ol class="timeline">
        {items.map((item) => (
          <li class="entry">
            <span class="pin" aria-hidden="true" />
            <NewsCard item={item} locale={locale} level={2} />
          </li>
        ))}
      </ol>
    </section>
  </main>

  <Footer locale={locale} />
  <ContactDialog locale={locale} email={email} />
</Base>

<style>
  .intro {
    padding-top: clamp(40px, 8vw, 104px);
    padding-bottom: clamp(48px, 7vw, 88px);
  }

  .title {
    margin: 28px 0 0;
    font-size: clamp(46px, 8vw, 112px);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.05em;
  }

  .title .serif {
    font-weight: 400;
    letter-spacing: -0.02em;
  }

  .accent {
    color: var(--accent);
  }

  .lead {
    max-width: 620px;
    margin: 36px 0 0;
    font-size: clamp(17px, 1.6vw, 20px);
    line-height: 1.6;
    color: var(--ink-2);
  }

  /* Timeline: a rail that draws itself as the page scrolls. */
  .timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin: 0;
    padding: 0 0 clamp(80px, 10vw, 140px) 56px;
    list-style: none;
  }

  .timeline::before {
    content: '';
    position: absolute;
    top: 8px;
    bottom: clamp(80px, 10vw, 140px);
    left: 11px;
    width: 2px;
    background: linear-gradient(var(--accent), color-mix(in srgb, var(--accent) 10%, transparent));
    transform-origin: top center;
    animation: grow-rail 1.8s var(--ease-in-out) 0.4s both;
  }

  @supports (animation-timeline: view()) {
    .timeline::before {
      animation: grow-rail linear both;
      animation-timeline: view();
      animation-range: entry 10% cover 60%;
    }
  }

  .entry {
    position: relative;
  }

  .pin {
    position: absolute;
    top: 34px;
    left: -52px;
    width: 16px;
    height: 16px;
    border: 2px solid var(--accent);
    border-radius: 50%;
    background: var(--bg);
  }

  .pin::after {
    content: '';
    position: absolute;
    inset: 3px;
    border-radius: 50%;
    background: var(--accent);
  }

  @keyframes grow-rail {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }

  @media (max-width: 640px) {
    .timeline {
      padding-left: 32px;
    }
    .timeline::before {
      left: 5px;
    }
    .pin {
      left: -33px;
      width: 14px;
      height: 14px;
    }
  }
</style>
