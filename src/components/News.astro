---
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { getNews, localePath } from '../i18n/utils';
import NewsCard from './NewsCard.astro';

interface Props {
  locale: Locale;
  number: string;
}

const { locale, number } = Astro.props;
const t = useTranslations(locale);
const items = (await getNews(locale)).slice(0, 3);
---

{items.length > 0 && (
  <section id="actualites" class="container section">
    <div class="head">
      <div>
        <p class="eyebrow reveal">
          <span class="tabular">{number}</span>
          <span>{t('news.label')}</span>
        </p>
        <h2 class="section-title reveal">
          {t('news.title.before')}
          <span class="serif">{t('news.title.accent')}</span>
        </h2>
      </div>
      <div class="head-side reveal">
        <p class="intro">{t('news.intro')}</p>
        <a href={localePath(locale, 'news')} class="link all">
          {t('news.all')}{' '}
          <span class="arrow" aria-hidden="true">
            →
          </span>
        </a>
      </div>
    </div>

    <div class="grid">
      {items.map((item) => (
        <NewsCard item={item} locale={locale} />
      ))}
    </div>
  </section>
)}

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }

  .head-side {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    max-width: 400px;
  }

  .intro {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
  }

  .all {
    font-size: 15px;
    font-weight: 500;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr));
    gap: 16px;
    margin-top: 56px;
  }
</style>
