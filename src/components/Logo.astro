---
/* The constellation mark: four linked stars, the last one in the accent color. */
---

<svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
  <path
    d="M4 20 L11 7 L18 15 L24 5"
    stroke="currentColor"
    stroke-width="1.2"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
  <circle cx="4" cy="20" r="2" fill="currentColor"></circle>
  <circle cx="11" cy="7" r="2" fill="currentColor"></circle>
  <circle cx="18" cy="15" r="2" fill="currentColor"></circle>
  <circle cx="24" cy="5" r="2.4" fill="var(--accent)"></circle>
</svg>
