---
import AboutView from '../../../views/AboutView.astro';
import NewsIndexView from '../../../views/NewsIndexView.astro';
import { locales, routes, type Locale } from '../../../i18n/config';

/*
 * Section pages, one per language:
 * the About page (/fr/a-propos/, /en/about/, /fi/tietoa/)
 * and the News page (/fr/actualites/, /en/news/, /fi/ajankohtaista/).
 */
export function getStaticPaths() {
  return locales.flatMap((lang) => [
    { params: { lang, section: routes.about[lang] }, props: { kind: 'about' as const } },
    { params: { lang, section: routes.news[lang] }, props: { kind: 'news' as const } },
  ]);
}

const locale = Astro.params.lang as Locale;
const { kind } = Astro.props;
---

{kind === 'about' ? <AboutView locale={locale} /> : <NewsIndexView locale={locale} />}
