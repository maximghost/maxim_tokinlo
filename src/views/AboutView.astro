---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Portrait from '../components/Portrait.astro';
import ContactDialog from '../components/ContactDialog.astro';
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const entry = await getEntry('about', locale);
if (!entry) throw new Error(`Missing About page for "${locale}" (src/content/about/${locale}.md)`);
const { Content } = await render(entry);
const email = 'yaovitokinlo13@gmail.com';

const facts = [
  { label: t('about.fact.education'), value: t('about.fact.education.value') },
  { label: t('about.fact.location'), value: t('about.fact.location.value') },
  { label: t('about.fact.company'), value: 'Ghost.Technologies' },
  { label: t('about.fact.tools'), value: 'TypeScript · React · Python · Supabase · PostgreSQL' },
];
---

<Base locale={locale} title={entry.data.title} description={entry.data.description}>
  <Header locale={locale} />

  <main id="contenu">
    <section id="intro" class="container intro">
      <div class="intro-grid">
        <div class="intro-main">
          <p class="eyebrow fade" style="animation-delay: 0.1s">
            {t('about.label')}
          </p>
          <h1 class="title">
            <span class="line">
              <span style="animation-delay: 0.2s">{t('about.title.before')}</span>
            </span>
            <span class="line">
              <span class="serif accent" style="animation-delay: 0.32s">
                {t('about.title.accent')}
              </span>
            </span>
          </h1>

          <dl class="facts fade" style="animation-delay: 0.6s">
            {facts.map((f) => (
              <div>
                <dt>{f.label}</dt>
                <dd>{f.value}</dd>
              </div>
            ))}
          </dl>
        </div>

        <Portrait alt={t('portrait.alt')} pendingLabel={t('portrait.pending')} />
      </div>
    </section>

    <section id="histoire" class="container body">
      <div class="prose reveal">
        <Content />
      </div>
    </section>

    <section id="contact" class="container closing">
      <h2 class="reveal">
        {t('about.cta.before')}
        <span class="serif">{t('about.cta.accent')}</span>
      </h2>
      <div class="cta-bottom reveal">
        <p>{t('contact.text')}</p>
        <a href={`mailto:${email}`} class="btn btn-primary btn-lg" data-contact-open>
          {t('contact.cta')}{' '}
          <span class="arrow" aria-hidden="true">
            →
          </span>
        </a>
      </div>
    </section>
  </main>

  <Footer locale={locale} />
  <ContactDialog locale={locale} email={email} />
</Base>

<style>
  .intro {
    padding-top: clamp(40px, 7vw, 96px);
    padding-bottom: 48px;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(240px, 340px);
    align-items: end;
    gap: 56px clamp(40px, 6vw, 96px);
  }

  .intro-main {
    min-width: 0;
    container-type: inline-size;
  }

  .title {
    margin: 28px 0 0;
    font-weight: 500;
    font-size: clamp(40px, 9cqi, 88px);
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .title :global(.line > span) {
    text-wrap: balance;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 24px 32px;
    margin: 56px 0 0;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .facts dt {
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .facts dd {
    margin: 8px 0 0;
    font-size: 15px;
    line-height: 1.55;
  }

  .body {
    padding-top: 96px;
    padding-bottom: 64px;
  }

  .closing {
    padding-top: 96px;
    padding-bottom: 96px;
  }

  .closing h2 {
    margin: 0;
    font-weight: 500;
    font-size: clamp(40px, 6vw, 84px);
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .cta-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }

  .cta-bottom p {
    margin: 0;
    font-size: 17px;
    color: var(--ink-2);
  }

  .btn-lg {
    min-height: 56px;
    padding: 0 30px;
    font-size: 16px;
  }

  @media (max-width: 860px) {
    .intro-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
